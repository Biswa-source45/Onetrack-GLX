# Copy this file to ".env" in this same folder (next to docker-compose.yml) on
# the HOST machine, then fill in real values. docker compose loads ".env"
# automatically — nothing else needs editing.
#
# Do NOT commit the real ".env" file — it's covered by .gitignore.

# Two long, random, unrelated strings. Generate with:
#   powershell -Command "[guid]::NewGuid().ToString() + [guid]::NewGuid().ToString()"
# Changing these logs everyone out (forces re-login) but does not touch any
# stored data or passwords.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# SMTP account OneTrack sends alert emails from.
EMAIL_SMTP_SERVER=
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=

# Public address people open OneTrack at (e.g. http://192.168.1.10). Alert
# emails get an "Open in OneTrack" button linking straight to the tender
# stage/approval they're about. Leave empty to send emails without it.
APP_BASE_URL=

# 72-working-hour deadline engine. Alerts are only sent when this is exactly "true".
# The first run after enabling records tenders already in the window without
# notifying anyone; only tenders entering the window afterwards are alerted.
CALENDAR_SCHEDULER_ENABLED=false
# Key for the Google holiday sync (takes priority over a key stored in the DB).
GOOGLE_CALENDAR_API_KEY=
