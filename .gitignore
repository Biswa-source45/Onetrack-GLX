# Host-level secrets file (see .env.example) — never commit the real one.
/.env
backend/.env

# Playwright CLI session artifacts (logs/screenshots) — disposable, regenerated per session.
.playwright-cli/

# Impeccable design-review scratch output — regenerated by the skill.
.impeccable/build/
.impeccable/review/*.png

# Stray compiled binaries that shouldn't be committed.
*.exe

# Feedback screenshot/photo uploads — bind-mounted host folder (see
# docker-compose.yml), user-uploaded content, not repo content.
/feedback-assets/
backend/uploads/
