# Host-level secrets file (see .env.example) — never commit the real one.
/.env
backend/.env

# Playwright CLI session artifacts (logs/screenshots) — disposable, regenerated per session.
.playwright-cli/

# Impeccable design-review scratch output — regenerated by the skill.
.impeccable/build/
.impeccable/review/*.png

# Stray compiled binaries that shouldn't be committed.
*.exe

# AI assistant skill folders (local tool config, not shared via git)
.claude/skills/
.agents/skills/

# graphify local-only output (graphify-out/ itself is committed so the team shares one map)
graphify-out/cost.json
graphify-out/.graphify_build_state.json
graphify-out/.graphify_labels.pending.json
graphify-out/20??-??-??/
graphify-out/cache/hook_sessions/

# Feedback screenshot/photo uploads — bind-mounted host folder (see
# docker-compose.yml), user-uploaded content, not repo content.
/feedback-assets/
backend/uploads/

# Lead documents — bind-mounted host folder, user-uploaded content.
/leads-assets/

# EMD payment/refund receipts — bind-mounted host folder, user-uploaded content.
/emd-assets/

# Tender documents (RFP, ATC, ...) — bind-mounted host folder, user-uploaded content.
/tender-assets/

# Build output / compiled binaries — built from source by the Dockerfiles, never versioned.
backend/bin/
/frontend/dist/
# Local Memurai/Redis files
dump.rdb
memurai-log.txt

# Node modules & Python virtual environments
node_modules/
**/node_modules/
ai_service/venv/
ai_service/.venv/
**/__pycache__/
*.pyc

# Local scratch & test files
create_test_files.py
run_e2e_tests.py
test_openai.go
test_real_user_docs.py
test_tender_sample.*
verify_end_to_end_flow.py
sample_unstructured_tender_document.pdf
scripts/


